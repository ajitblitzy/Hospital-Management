# ===========================================================================
# Hospital Management System (HMS) - Frontend (React + Vite) environment template
# ---------------------------------------------------------------------------
# HOW TO USE
#   Copy this file to `.env` in this `frontend/` directory and adjust the
#   values for your local setup:  cp .env.example .env
#   `.env` is gitignored (see the root .gitignore); this committed
#   `.env.example` template MUST NOT contain real secrets.
#
# CRITICAL - Vite exposure rule
#   Only variables prefixed with `VITE_` are exposed to client (browser) code
#   via `import.meta.env`. Everything that reaches the browser bundle is
#   PUBLIC, so do NOT put secrets here (JWT secrets, database credentials,
#   SMTP / AWS / SMS keys, etc.). Server-side secrets live ONLY in the ROOT
#   `../.env.example`. Keep the values below consistent with that root file.
# ===========================================================================

# Base URL of the backend API gateway (the axios client appends the /api prefix,
# so requests resolve to /api/auth, /api/patients, ... /api/reports).
# Keep in sync with API_GATEWAY_PORT / VITE_API_BASE_URL in the root ../.env.example.
VITE_API_BASE_URL=http://localhost:8080

# Human-readable app name shown in the UI title bar / login screen.
VITE_APP_NAME=Hospital Management System

# Idle session timeout in minutes (client-side auto-logout; mirrors backend
# SESSION_TIMEOUT_MINUTES in the root ../.env.example).
VITE_SESSION_TIMEOUT_MINUTES=30

# Request timeout for API calls, in milliseconds.
VITE_API_TIMEOUT_MS=30000
