# =============================================================================
# Hospital Management System (HMS) - AWS Infrastructure EXAMPLE tfvars
# -----------------------------------------------------------------------------
# Copy to terraform.tfvars and customize. DO NOT put secrets here - DB/Redis
# passwords are auto-generated; AWS creds come from your environment/CLI.
#
# Details:
#   * DB (PostgreSQL) and Redis passwords / AUTH tokens are NOT set here. They
#     are generated by Terraform (`random_password`) and stored in AWS Secrets
#     Manager by secrets.tf / rds.tf / elasticache.tf.
#   * AWS credentials are read from your environment / AWS CLI profile / CI role
#     (env vars, shared credentials file, or an assumed IAM role) - NEVER from
#     this file.
#
# WHY ".example": Terraform auto-loads ONLY `terraform.tfvars` and
# `*.auto.tfvars`, so this ".example" file is NEVER auto-loaded. It is a safe,
# committed template (like the root ../../.env.example). To use it:
#
#     cp terraform.tfvars.example terraform.tfvars   # terraform.tfvars is gitignored
#     terraform init
#     terraform plan                                 # AWS creds come from env/CLI
#
# Every key below is a variable declared in variables.tf (no unknown keys). The
# values shown are the recommended production-grade defaults; adjust them to fit
# your account, region, sizing, and cost targets. All values are type-correct
# HCL: strings quoted, numbers/bools unquoted, lists as lists, tags as a
# string-to-string map.
# =============================================================================

# -----------------------------------------------------------------------------
# Global / naming
# -----------------------------------------------------------------------------
# Short, lowercase, DNS-friendly slug used as a prefix in resource names & tags.
project_name = "hms"
# Deployment environment identifier (production | staging | development).
# Combined with project_name to build the resource name_prefix.
environment = "production"
# Region for ALL regional resources (VPC, EKS, RDS, ElastiCache, S3).
# MUST match AWS_REGION in the root ../../.env.example.
aws_region = "us-east-1"
# Extra cost-allocation / ownership tags merged into the common tag set applied
# to every taggable resource. Add your own keys as needed.
tags = { Owner = "platform-team", CostCenter = "hms" }

# -----------------------------------------------------------------------------
# Networking (VPC - multi-AZ for high availability)
# -----------------------------------------------------------------------------
# IPv4 CIDR for the HMS VPC; a /16 leaves ample room for the /20 subnets below.
vpc_cidr = "10.0.0.0/16"
# Number of Availability Zones to span (must be >= 2 for HA and <= the number
# of subnet CIDRs supplied below).
az_count = 3
# One public subnet CIDR per AZ (internet-facing load balancers + NAT gateways).
public_subnet_cidrs = ["10.0.0.0/20", "10.0.16.0/20", "10.0.32.0/20"]
# One private subnet CIDR per AZ (EKS nodes, RDS, ElastiCache; no inbound net).
private_subnet_cidrs = ["10.0.48.0/20", "10.0.64.0/20", "10.0.80.0/20"]
# Provision NAT gateway(s) so private-subnet resources have outbound egress.
enable_nat_gateway = true
# false = one NAT gateway per AZ (recommended for prod: no cross-AZ SPOF, avoids
#         cross-AZ egress data-transfer charges).
# true  = single shared NAT gateway (cheaper for non-prod; sacrifices AZ-level HA).
single_nat_gateway = false

# -----------------------------------------------------------------------------
# EKS (Kubernetes platform - horizontal scaling)
# -----------------------------------------------------------------------------
# Kubernetes minor version for the control plane AND the managed node groups.
eks_cluster_version = "1.30"
# Instance type(s) eligible for the managed node group (first is primary).
eks_node_instance_types = ["t3.large"]
# Steady-state worker node count (spread across the AZs).
eks_node_desired_size = 3
# Autoscaler floor (kept at multi-AZ parity to preserve availability at low load).
eks_node_min_size = 3
# Autoscaler ceiling for peak load (horizontal scaling limit).
eks_node_max_size = 6
# EBS root volume size (GiB) per node - OS, container images, ephemeral storage.
eks_node_disk_size = 50
# Expose the EKS API-server endpoint publicly (pair with a strict allowlist).
eks_endpoint_public_access = true
# CIDRs allowed to reach the public EKS API endpoint. 0.0.0.0/0 is open to the
# whole internet - RESTRICT this to your office / VPN CIDRs in production.
eks_public_access_cidrs = ["0.0.0.0/0"]

# -----------------------------------------------------------------------------
# RDS PostgreSQL 16 (managed primary + read replica -> "Database replication")
# -----------------------------------------------------------------------------
# NOTE: the master password is NOT set here - Terraform generates it
# (random_password) and stores it in AWS Secrets Manager (rds.tf / secrets.tf).
#
# Engine version - MUST stay in the PostgreSQL 16 family (matches postgres:16 in
# the root docker-compose.yml). A minor may be pinned (e.g. "16.4"); keep 16.
postgres_version = "16"
# DB instance class (compute/memory) for the primary and its read replica(s).
postgres_instance_class = "db.t3.medium"
# Initial allocated storage (GiB) for the primary.
postgres_allocated_storage = 50
# Storage-autoscaling upper bound (GiB); must be >= postgres_allocated_storage.
postgres_max_allocated_storage = 200
# Initial application database name - MUST equal POSTGRES_DB in ../../.env.example.
postgres_db_name = "hms"
# Master username - MUST equal POSTGRES_USER in ../../.env.example.
postgres_username = "hms_user"
# Listener port - MUST equal POSTGRES_PORT in ../../.env.example.
postgres_port = 5432
# Deploy the primary as Multi-AZ (synchronous standby for automatic failover).
postgres_multi_az = true
# Read-replica count (>= 1 implements "Database replication"; set 0 to disable).
postgres_read_replica_count = 1
# Automated-backup / point-in-time-recovery retention window (days).
postgres_backup_retention_days = 7
# Block an accidental `terraform destroy` of the DB holding patient data.
postgres_deletion_protection = true
# Encrypt storage at rest ("Encrypted patient data storage"); keep true.
postgres_storage_encrypted = true

# -----------------------------------------------------------------------------
# ElastiCache Redis 7 (caching, sessions, async job processing)
# -----------------------------------------------------------------------------
# NOTE: the Redis AUTH token is NOT set here - when redis_auth_enabled = true
# Terraform generates it (random_password) and stores it in Secrets Manager.
#
# Engine version - MUST stay in the Redis 7 family (matches redis:7 in the root
# docker-compose.yml).
redis_version = "7.1"
# Cache node instance type (compute/memory) for each Redis node.
redis_node_type = "cache.t3.micro"
# Nodes in the replication group: 1 primary + (n-1) replicas; >= 2 for HA.
redis_num_cache_clusters = 2
# Listener port - MUST equal REDIS_PORT in ../../.env.example.
redis_port = 6379
# Promote a replica to primary automatically on failure (requires >= 2 nodes).
redis_automatic_failover = true
# Distribute the primary/replica node(s) across AZs for high availability.
redis_multi_az = true
# Encrypt cached data at rest (may hold sensitive patient info); keep true.
redis_at_rest_encryption = true
# Encrypt connections in transit (TLS); MUST be true when redis_auth_enabled = true.
redis_transit_encryption = true
# Require an AUTH token on every connection (token auto-generated; needs TLS above).
redis_auth_enabled = true

# -----------------------------------------------------------------------------
# S3 (patient identification-document uploads)
# -----------------------------------------------------------------------------
# Keep false so `terraform destroy` cannot delete a non-empty uploads bucket.
# Set true ONLY for disposable, non-production buckets you fully intend to empty.
s3_force_destroy = false
# Preserve prior versions of uploaded documents (guards against overwrite/delete).
s3_versioning_enabled = true

# Optional: pin an explicit uploads-bucket name. Leave this COMMENTED to let
# main.tf compute a deterministic, globally-unique name from the project name,
# environment, and AWS account id. Uncomment and set ONLY to reuse a specific
# pre-existing bucket name.
# s3_bucket_name_override = "my-existing-hms-uploads-bucket"
