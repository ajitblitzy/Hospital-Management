# =============================================================================
# HMS End-to-End (Playwright) test suite — environment configuration TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to `.env` (gitignored) and adjust for your environment.
# The suite works out-of-the-box against a freshly seeded LOCAL stack with NO
# edits (the values below are the defaults).
#
# PATIENT-DATA PRIVACY: all data/credentials are SYNTHETIC / SEEDED, dev-only.
# NEVER put real patient PII or production secrets in this file.
# =============================================================================

# --- System under test -------------------------------------------------------
# Base URL of the running React frontend that Playwright drives (Playwright baseURL).
FRONTEND_URL=http://localhost:3000

# Base URL of the backend API gateway (for API-assisted setup / health checks).
# Test code appends the `/api` prefix, e.g. ${API_BASE_URL}/api/auth/login.
API_BASE_URL=http://localhost:8080

# --- Seeded role credentials --------------------------------------------------
# Credentials default to the seeded demo users provided by @hms/test-fixtures
# (../fixtures), which mirror ../../database/seeds. Override per environment by
# uncommenting the lines below. TEST_DEFAULT_PASSWORD overrides the shared
# default password for every role.
#
# TEST_DEFAULT_PASSWORD=ChangeMe123!
#
# TEST_ADMIN_EMAIL=admin@hms.local
# TEST_ADMIN_PASSWORD=ChangeMe123!
# TEST_DOCTOR_EMAIL=doctor@hms.local
# TEST_DOCTOR_PASSWORD=ChangeMe123!
# TEST_NURSE_EMAIL=nurse@hms.local
# TEST_NURSE_PASSWORD=ChangeMe123!
# TEST_RECEPTIONIST_EMAIL=receptionist@hms.local
# TEST_RECEPTIONIST_PASSWORD=ChangeMe123!
# TEST_LABTECH_EMAIL=labtech@hms.local
# TEST_LABTECH_PASSWORD=ChangeMe123!
# TEST_PHARMACIST_EMAIL=pharmacist@hms.local
# TEST_PHARMACIST_PASSWORD=ChangeMe123!
# TEST_PATIENT_EMAIL=patient@hms.local
# TEST_PATIENT_PASSWORD=ChangeMe123!
# TEST_INSURANCE_EMAIL=insurance@hms.local
# TEST_INSURANCE_PASSWORD=ChangeMe123!

# --- Run behavior -------------------------------------------------------------
# Set CI=1 in continuous integration to enable retries, a single worker and
# forbidOnly (see playwright.config.js).
# CI=1
