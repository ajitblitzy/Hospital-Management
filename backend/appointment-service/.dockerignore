# Dependencies (reinstalled inside the image)
node_modules
**/node_modules

# Logs
*.log
npm-debug.log*

# Tests, coverage, CI artifacts
test
coverage
.nyc_output

# Env & secrets (never bake into images)
.env
.env.*
!.env.example

# Docker / VCS / docs (not needed at runtime)
.git
.gitignore
Dockerfile
.dockerignore
*.md

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
