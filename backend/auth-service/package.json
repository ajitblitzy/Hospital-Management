{
  "name": "@hms/auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "HMS Authentication & Authorization microservice — secure login, JWT issuance/refresh, MFA (TOTP), session management, RBAC role/permission management, and audit logging.",
  "license": "UNLICENSED",
  "main": "src/server.js",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@hms/shared": "*",
    "express": "^4.18.2",
    "bcrypt": "^5.1.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "nodemon": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "coverage",
    "clearMocks": true,
    "verbose": true
  }
}
