# ===========================================================================
# Hospital Management System (HMS) - Environment Variable Template
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# This template is committed and MUST NOT contain real secrets.
# ===========================================================================

# ---- General ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API Gateway / Service Ports ----
# Illustrative per-service ports; individual service agents may adjust.
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=4001
PATIENT_SERVICE_PORT=4002
APPOINTMENT_SERVICE_PORT=4003
EMR_SERVICE_PORT=4004
PHARMACY_SERVICE_PORT=4005
LABORATORY_SERVICE_PORT=4006
BILLING_SERVICE_PORT=4007
INVENTORY_SERVICE_PORT=4008
REPORTS_SERVICE_PORT=4009

# ---- PostgreSQL ----
# NOTE: inside the docker-compose network the host is the service name `postgres`, not `localhost`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hms
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://hms_user:change_me@localhost:5432/hms

# ---- Redis ----
# NOTE: inside the docker-compose network the host is the service name `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---- JWT / Auth / Session / MFA ----
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me
JWT_REFRESH_EXPIRES_IN=7d
SESSION_TIMEOUT_MINUTES=30
MFA_ISSUER=HMS

# ---- Data Encryption (encrypted patient data at rest) ----
DATA_ENCRYPTION_KEY=change_me

# ---- Email (SMTP) - appointment reminders / notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@hms.local

# ---- SMS provider - appointment reminders ----
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ---- AWS (cloud platform / object storage) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---- File uploads (patient identification documents) ----
UPLOAD_MAX_SIZE_MB=10
UPLOAD_STORAGE=s3

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000
# Build-tool specific base URL (frontend uses Vite -> VITE_ prefix).
VITE_API_BASE_URL=http://localhost:8080
