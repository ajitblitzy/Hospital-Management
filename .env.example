# ===========================================================================
# Hospital Management System (HMS) - Environment Variable Template
# ---------------------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file to `.env`  (e.g. `cp .env.example .env`).
#   2. Replace every `change_me` and fill in every empty value with a REAL
#      secret / setting appropriate for your environment.
#   3. NEVER commit your real `.env` - it is gitignored. THIS template file
#      (`.env.example`) is committed and MUST contain ONLY safe placeholders.
#
# FORMAT: plain `KEY=value` lines (dotenv-parseable). Comment lines start with
# `#`. Every variable below is documented with a short comment describing it.
# ===========================================================================

# ===========================================================================
# General
# ===========================================================================
# Runtime environment: development | test | production. Controls logging,
# error verbosity, and runtime optimizations across all services.
NODE_ENV=development
# Application log verbosity: error | warn | info | http | debug | trace.
LOG_LEVEL=info

# ===========================================================================
# API Gateway / Service Ports
# ===========================================================================
# NOTE: The ports below are ILLUSTRATIVE for local (non-Docker) runs, and
# individual service agents may adjust them. Inside docker-compose the same
# ports are used and each service is reachable by its service name.
#
# Public entrypoint: the API gateway that fronts all backend microservices.
API_GATEWAY_PORT=8080
# Authentication & authorization service (login, JWT issuance, MFA, RBAC).
AUTH_SERVICE_PORT=4001
# Patient registration & profile service (patient records, ID documents).
PATIENT_SERVICE_PORT=4002
# Appointment management service (doctor calendars, bookings, reminders).
APPOINTMENT_SERVICE_PORT=4003
# Electronic Medical Records (EMR) service (clinical notes & history).
EMR_SERVICE_PORT=4004
# Pharmacy service (medicine inventory, prescriptions, expiry alerts).
PHARMACY_SERVICE_PORT=4005
# Laboratory service (lab orders and result reports).
LABORATORY_SERVICE_PORT=4006
# Billing & payments service (invoices, insurance claims, payments).
BILLING_SERVICE_PORT=4007
# Inventory service (medical supplies & stock management).
INVENTORY_SERVICE_PORT=4008
# Reporting & analytics service (operational & clinical reports).
REPORTS_SERVICE_PORT=4009

# ===========================================================================
# PostgreSQL (primary relational datastore)
# ===========================================================================
# NOTE: Within the docker-compose network the host is the service name
# `postgres`; `localhost` is correct for local / published-port runs.
#
# PostgreSQL server hostname.
POSTGRES_HOST=localhost
# PostgreSQL server port.
POSTGRES_PORT=5432
# Application database name.
POSTGRES_DB=hms
# Database username the application connects as.
POSTGRES_USER=hms_user
# Database password - REPLACE with a strong secret in `.env`.
POSTGRES_PASSWORD=change_me
# Full PostgreSQL connection string (DSN). Keep its credentials in sync with
# the POSTGRES_* values above; used by services that take a single DSN.
DATABASE_URL=postgresql://hms_user:change_me@localhost:5432/hms

# ===========================================================================
# Redis (caching, sessions, async job processing)
# ===========================================================================
# NOTE: Within the docker-compose network the host is the service name `redis`.
#
# Redis server hostname.
REDIS_HOST=localhost
# Redis server port.
REDIS_PORT=6379
# Redis password - leave EMPTY if the local instance requires no auth.
REDIS_PASSWORD=
# Full Redis connection URL (use redis://:password@host:port when auth is set).
REDIS_URL=redis://localhost:6379

# ===========================================================================
# JWT / Authentication / Session / MFA
# ===========================================================================
# Secret used to SIGN short-lived access tokens - REPLACE with a long random value.
JWT_SECRET=change_me
# Access-token lifetime (e.g. 15m, 1h). Keep short for security.
JWT_EXPIRES_IN=15m
# Secret used to SIGN refresh tokens - MUST differ from JWT_SECRET. REPLACE it.
JWT_REFRESH_SECRET=change_me
# Refresh-token lifetime (e.g. 7d, 30d).
JWT_REFRESH_EXPIRES_IN=7d
# Idle session timeout, in minutes, before re-authentication is required.
SESSION_TIMEOUT_MINUTES=30
# TOTP issuer label shown in authenticator apps for MFA (privileged users).
MFA_ISSUER=HMS

# ===========================================================================
# Data Encryption (encrypted patient data at rest)
# ===========================================================================
# Symmetric key for field-level encryption of sensitive patient data -
# REPLACE with a 32-byte (256-bit) random key. Changing it re-keys the data.
DATA_ENCRYPTION_KEY=change_me

# ===========================================================================
# Email (SMTP) - appointment reminders & transactional notifications
# ===========================================================================
# SMTP server hostname (e.g. smtp.example.com). Leave EMPTY to disable email.
SMTP_HOST=
# SMTP port (587 for STARTTLS, 465 for implicit TLS, 25 for plain).
SMTP_PORT=587
# SMTP account username / API user.
SMTP_USER=
# SMTP account password / API key - REPLACE in `.env`.
SMTP_PASSWORD=
# Default "From" address for outbound HMS emails.
EMAIL_FROM=no-reply@hms.local

# ===========================================================================
# SMS Provider - appointment reminders
# ===========================================================================
# SMS gateway identifier (e.g. twilio, sns, messagebird). Empty disables SMS.
SMS_PROVIDER=
# API key / token for the SMS provider - REPLACE in `.env`.
SMS_API_KEY=
# Sender ID / originating number displayed to recipients.
SMS_SENDER_ID=

# ===========================================================================
# AWS (cloud platform / object storage)
# ===========================================================================
# AWS region for all AWS-backed resources (S3, etc.).
AWS_REGION=us-east-1
# AWS access key ID - REPLACE in `.env` (prefer IAM roles in production).
AWS_ACCESS_KEY_ID=
# AWS secret access key - REPLACE in `.env` (prefer IAM roles in production).
AWS_SECRET_ACCESS_KEY=
# S3 bucket name for stored patient identification documents & uploads.
AWS_S3_BUCKET=

# ===========================================================================
# File Uploads (patient identification documents)
# ===========================================================================
# Maximum accepted upload size, in megabytes.
UPLOAD_MAX_SIZE_MB=10
# Upload storage backend: `s3` (uses the AWS_* values above) or `local` (disk).
UPLOAD_STORAGE=s3

# ===========================================================================
# Frontend
# ===========================================================================
# Public URL where the React frontend is served (used for CORS & links).
FRONTEND_URL=http://localhost:3000
# Base URL the frontend uses to reach the API gateway. The frontend is built
# with Vite, which only exposes vars prefixed with `VITE_` to client code.
# (If a CRA / react-scripts build is used instead, mirror this value as
#  REACT_APP_API_BASE_URL.)
VITE_API_BASE_URL=http://localhost:8080
